# External data sync (YouTube, GitHub) every hour.
# Install: sudo cp cron/astronautmarkus_sync /etc/cron.d/  (filename must have no dots; owned by root, mode 644)
SHELL=/bin/sh
PYTHONUNBUFFERED=1

0 * * * * astronautmarkus cd /var/www/astronautmarkus.dev && .venv/bin/python app/scripts/sync.py 2>&1 | logger -t astronautmarkus_sync
